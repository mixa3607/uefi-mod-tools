<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>uefi-mod-tools</AssemblyName>
		<VersionPrefix>1.0.1</VersionPrefix>
	</PropertyGroup>

	<PropertyGroup>
		<PublishAot>true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Commands\UefiTools\UefiEditor\Resources\editor.html" LogicalName="UefiEditor.Template" />
		<EmbeddedResource Include="Commands\UefiTools\UefiEditor\HtmlViewer\Resources\dist\viewer.css" LogicalName="UefiEditor.Styles" />
		<EmbeddedResource Include="Commands\UefiTools\UefiEditor\HtmlViewer\Resources\dist\viewer.js" LogicalName="UefiEditor.Script" />
		<UefiEditorClientSource Include="Commands\UefiTools\UefiEditor\HtmlViewer\Client\**\*" Exclude="Commands\UefiTools\UefiEditor\HtmlViewer\Client\node_modules\**" />
	</ItemGroup>

	<Target Condition="'$(BuildEditorFrontend)'==True" Name="BuildUefiEditor" BeforeTargets="PrepareResources" Inputs="@(UefiEditorClientSource)" Outputs="$(MSBuildProjectDirectory)\Commands\UefiTools\UefiEditor\HtmlViewer\Resources\dist\viewer.js;$(MSBuildProjectDirectory)\Commands\UefiTools\UefiEditor\HtmlViewer\Resources\dist\viewer.css">
		<Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)\Commands\UefiTools\UefiEditor\HtmlViewer\Client" Condition="!Exists('$(MSBuildProjectDirectory)\Commands\UefiTools\UefiEditor\HtmlViewer\Client\node_modules')" />
		<Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\Commands\UefiTools\UefiEditor\HtmlViewer\Client" />
	</Target>

	<ItemGroup>
		<PackageReference Include="ConsoleTables" Version="2.7.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="System.CommandLine" Version="2.0.1" />
		<PackageReference Include="System.IO.Hashing" Version="10.0.1" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\ArkProjects.UefiModTools.Ifr\ArkProjects.UefiModTools.Ifr.csproj" />
	  <ProjectReference Include="..\ArkProjects.UefiModTools.Smbios\ArkProjects.UefiModTools.Smbios.csproj" />
	</ItemGroup>

</Project>
